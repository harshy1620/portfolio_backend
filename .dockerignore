# Dependencies (will be installed inside the image)
node_modules

# Secrets (passed at runtime via --env-file, not baked in)
.env
.env.*
!.env.example

# Git
.git
.gitignore
.gitattributes

# IDE / OS
.vscode
.idea
.DS_Store
Thumbs.db

# Logs
*.log
logs

