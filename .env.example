# Server
PORT=5000
NODE_ENV=development

# CORS — comma-separated list of allowed origins
# In dev: http://localhost:3000  (your Next.js portfolio)
# In prod: https://d2oat8oeneh958.cloudfront.net
CORS_ORIGINS=http://localhost:3000

# Google Gemini (free tier — get key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# MongoDB Atlas
# Format: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<db_name>?appName=Cluster0
MONGODB_URI=

# AWS S3 (for resume uploads)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
