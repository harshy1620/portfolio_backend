# Server
PORT=5000
NODE_ENV=development

# CORS — comma-separated list of allowed origins
# In dev: http://localhost:3000  (your Next.js portfolio)
# In prod: https://d2oat8oeneh958.cloudfront.net
CORS_ORIGINS=http://localhost:3000

# OpenAI
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# MongoDB Atlas
# Format: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/<db_name>?appName=Cluster0
MONGODB_URI=
